# 复制为 /etc/linux-worker/<实例>.env ，权限必须是 0600。
# 环境变量优先于本文件。不要把密钥写进命令行或日志。

HUB_BASE_URL=https://www.chuhaijian.com/task
AGENT_ALIAS=linux-__NAME__
LLM_BASE_URL=https://aigc.gether.net/v1
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

WORKSPACE_DIR=__HOME__/workspace
STATE_FILE=__HOME__/state.json
TEAM_INVITE_CODE=
# 一对一 Topic 码。可以只填这项、只填上面的团队邀请，或两项都填。
TOPIC_INVITE_CODE=

# 远程目标。逗号或空白分隔。支持 IP、CIDR、域名。不要写 *。
# 留空时只能访问 127.0.0.1 / localhost 和工作区。
TARGET_ALLOWLIST=

SEARCH_BACKEND=http
# 从北京可直接访问，不需要搜索密钥。必须包含 {query}。
SEARCH_URL=https://cn.bing.com/search?q={query}
# SEARCH_BACKEND=openai 时改为搜索服务的根地址，例如 https://example.com/v1
SEARCH_BASE_URL=
SEARCH_API_KEY=
SEARCH_MODEL=

# 主模型返回 insufficient_user_quota / 403 额度错误时，用同一把密钥改试一次。留空则只回报额度不足。
LLM_FALLBACK_MODEL=

# 每条指令最多多少次模型往返。简单的 nmap / hostname 在 16 步时会停在「已达到步数上限」。
MAX_STEPS=40
# 只累计新产生的输出和工具文本，不把每次响应的 total_tokens 加总。这是安全上限。
MAX_TOKENS=200000
SHELL_TIMEOUT=120
SHELL_OUTPUT_LIMIT=16000
RELAY_WAIT=20
ERROR_SLEEP=5
LLM_MAX_OUTPUT=1024
# 由 systemd 以非特权用户运行时留空。仅当进程本身是 root 时才填写。
SHELL_USER=
